{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "process_scores row (one per mode/level/seed/session) — written by the judge step (eval/rubric_process.md)",
  "type": "object",
  "required": ["mode", "level", "seed", "session", "dims"],
  "properties": {
    "mode": {"enum": ["baseline-general", "throughline-solo"]},
    "level": {"enum": ["beginner", "intermediate", "advanced"]},
    "seed": {"type": "string"},
    "session": {"type": "integer", "minimum": 0},
    "dims": {
      "type": "object",
      "required": ["clarification_quality", "over_questioning", "conflict_detection", "change_classification", "user_burden"],
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 3}
    },
    "total": {"type": "integer", "minimum": 0, "maximum": 15},
    "note": {"type": "string"},
    "judge": {"type": "string"}
  }
}
